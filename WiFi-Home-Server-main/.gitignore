# ── Python ────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.pyo
*.pyd
.Python

# ── Virtual environments ──────────────────────────────────────────
.venv/
venv/
env/
.env/
ENV/

# ── Environment / secrets (NEVER commit these) ────────────────────
.env
*.env
*.secret
*.secrets
secrets.json

# ── TLS / crypto key files (auto-generated at runtime; stored in %APPDATA%) ──
*.pem
*.key
*.p12
*.pfx
*.crt
*.cer

# ── PyInstaller build artefacts ───────────────────────────────────
build/
dist/
*.spec.bak
*.egg-info/

# ── IDE / editor ──────────────────────────────────────────────────
.vscode/
.idea/
*.suo
*.user
*.swp
*~
.DS_Store
Thumbs.db

# ── Test / coverage artefacts ─────────────────────────────────────
.coverage
htmlcov/
.pytest_cache/
coverage.xml
*.log

# ── Miscellaneous temporary files ─────────────────────────────────
*.tmp
*.bak
*.orig